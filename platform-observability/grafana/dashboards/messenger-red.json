{
 "uid": "messenger-red",
 "title": "Messenger Service \u2014 RED & Projections",
 "tags": [
  "platform",
  "messenger-service"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 401,
   "type": "timeseries",
   "title": "Request rate by route",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(messenger_service_http_requests_total[5m])) by (route)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 402,
   "type": "timeseries",
   "title": "Errors",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(messenger_service_http_requests_total{code=~\"4..\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "4xx"
    },
    {
     "refId": "B",
     "expr": "sum(rate(messenger_service_http_requests_total{code=~\"5..\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 403,
   "type": "timeseries",
   "title": "Latency p50 / p95 / p99",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum(rate(messenger_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(messenger_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum(rate(messenger_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 404,
   "type": "timeseries",
   "title": "Messages sent by kind (1h window)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(messenger_service_messages_sent_total[1h])) by (kind)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 405,
   "type": "timeseries",
   "title": "Conversations created by type (24h window)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(messenger_service_conversations_created_total[24h])) by (type)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{type}}"
    }
   ],
   "description": "Idempotent hits are not counted, so a direct conversation appears once however often it is re-requested."
  },
  {
   "id": 406,
   "type": "timeseries",
   "title": "Read receipts (1h window)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(messenger_service_read_receipts_total[1h]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "watermark advances"
    }
   ]
  },
  {
   "id": 407,
   "type": "timeseries",
   "title": "Live fan-out to core NATS by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(messenger_service_fanout_publish_total[5m])) by (outcome)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{outcome}}"
    }
   ],
   "description": "Core NATS is fire-and-forget. A rising error line means live frames are being dropped \u2014 the thread still corrects itself on the next fetch, which is why this is a signal and not an alert."
  },
  {
   "id": 408,
   "type": "timeseries",
   "title": "JetStream envelope publishes by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 24
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(messenger_service_event_publish_total[5m])) by (outcome)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{outcome}}"
    }
   ],
   "description": "Published after commit. An error here means event-store is missing domain events the database already has."
  },
  {
   "id": 409,
   "type": "timeseries",
   "title": "Call events projected by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 32
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(messenger_service_calls_projected_total[5m])) by (outcome)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{outcome}}"
    }
   ],
   "description": "The consumer that writes call history. Failures here are why a thread would show a call that never ends, or no call row at all."
  },
  {
   "id": 410,
   "type": "timeseries",
   "title": "Attachment grants by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 32
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(messenger_service_attachment_grants_total[5m])) by (outcome)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{outcome}}"
    }
   ],
   "description": "Short-lived download URLs brokered to file-service. Errors usually mean file-service (:3001) is down, which presents to the user as a broken picture rather than an error."
  },
  {
   "id": 411,
   "type": "logs",
   "title": "Logs",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 40
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service_name=\"messenger-service\"} | json",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ]
}
