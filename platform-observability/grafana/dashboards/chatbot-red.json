{
 "uid": "chatbot-red",
 "title": "Chatbot \u2014 Service & Worker",
 "tags": [
  "platform",
  "chatbot-service"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 102,
   "type": "timeseries",
   "title": "Request rate by handler",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "X",
     "expr": "sum(rate(chatbot_service_http_requests_total[5m])) by (handler)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{handler}}"
    }
   ]
  },
  {
   "id": 103,
   "type": "timeseries",
   "title": "Errors",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(chatbot_service_http_requests_total{status=\"4xx\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "4xx"
    },
    {
     "refId": "B",
     "expr": "sum(rate(chatbot_service_http_requests_total{status=\"5xx\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 104,
   "type": "timeseries",
   "title": "Latency p50 / p95 / p99",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum(rate(chatbot_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(chatbot_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum(rate(chatbot_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 106,
   "type": "timeseries",
   "title": "Worker jobs by outcome",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "B",
     "expr": "sum(rate(chatbot_worker_jobs_total[5m])) by (status)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{status}}"
    }
   ]
  },
  {
   "id": 107,
   "type": "timeseries",
   "title": "Worker job duration p50 / p95",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum(rate(chatbot_worker_job_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(chatbot_worker_job_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 108,
   "type": "logs",
   "title": "Service + worker logs",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 16
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service_name=~\"chatbot-service|chatbot-worker\"} | json",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ]
}
