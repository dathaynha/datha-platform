     },
     "legendFormat": "accounts-service"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "5xx error ratio per service",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "max": 1,
     "min": 0
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(gateway_http_requests_total{code=~\"5..\"}[5m])) / sum(rate(gateway_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "api-gateway"
    },
    {
     "refId": "B",
     "expr": "sum(rate(event_store_http_requests_total{code=~\"5..\"}[5m])) / sum(rate(event_store_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "event-store"
    },
    {
     "refId": "C",
     "expr": "sum(rate(file_service_http_requests_total{code=~\"5..\"}[5m])) / sum(rate(file_service_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "file-service"
    },
    {
     "refId": "D",
     "expr": "sum(rate(chatbot_service_http_requests_total{status=\"5xx\"}[5m])) / sum(rate(chatbot_service_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "chatbot-service"
    },
    {
     "refId": "E",
     "expr": "sum(rate(messenger_service_http_requests_total{code=~\"5..\"}[5m])) / sum(rate(messenger_service_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "messenger-service"
    },
    {
     "refId": "F",
     "expr": "sum(rate(notification_service_http_requests_total{code=~\"5..\"}[5m])) / sum(rate(notification_service_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "notification-service"
    },
    {
     "refId": "G",
     "expr": "sum(rate(accounts_service_http_requests_total{code=~\"5..\"}[5m])) / sum(rate(accounts_service_http_requests_total[5m]))",
