  {
   "id": 7,
   "type": "timeseries",
   "title": "Request rate per service",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(gateway_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "api-gateway"
    },
    {
     "refId": "B",
     "expr": "sum(rate(event_store_http_requests_total[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "event-store"
    },
    {
     "refId": "C",
