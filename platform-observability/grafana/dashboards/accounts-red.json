{
 "uid": "accounts-red",
 "title": "Accounts Service \u2014 RED & Directory",
 "tags": [
  "platform",
  "accounts-service"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "30s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "panels": [
  {
   "id": 601,
   "type": "timeseries",
   "title": "Request rate by route",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(accounts_service_http_requests_total[5m])) by (route)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{route}}"
    }
   ]
  },
  {
   "id": 602,
   "type": "timeseries",
   "title": "Errors",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 0
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(accounts_service_http_requests_total{code=~\"4..\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "4xx"
    },
    {
     "refId": "B",
     "expr": "sum(rate(accounts_service_http_requests_total{code=~\"5..\"}[5m]))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "5xx"
    }
   ]
  },
  {
   "id": 603,
   "type": "timeseries",
   "title": "Latency p50 / p95 / p99",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 0,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.50, sum(rate(accounts_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(accounts_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p95"
    },
    {
     "refId": "C",
     "expr": "histogram_quantile(0.99, sum(rate(accounts_service_http_request_duration_seconds_bucket[5m])) by (le))",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "p99"
    }
   ]
  },
  {
   "id": 604,
   "type": "timeseries",
   "title": "User syncs by outcome (1h window)",
   "gridPos": {
    "h": 8,
    "w": 12,
    "x": 12,
    "y": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(accounts_service_users_provisioned_total[1h])) by (outcome)",
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "legendFormat": "{{outcome}}"
    }
   ],
   "description": "The shell POSTs /users/me/sync on every start with a valid session. A failure here is invisible in the UI and shows up later as a person missing from directory search \u2014 there is no row for them to find."
  },
  {
   "id": 605,
   "type": "logs",
   "title": "Logs",
   "gridPos": {
    "h": 8,
    "w": 24,
    "x": 0,
    "y": 16
   },
   "datasource": {
    "type": "loki",
    "uid": "loki"
   },
   "options": {
    "showTime": true,
    "wrapLogMessage": true,
    "sortOrder": "Descending",
    "enableLogDetails": true
   },
   "targets": [
    {
     "refId": "A",
     "expr": "{service_name=\"accounts-service\"} | json",
     "datasource": {
      "type": "loki",
      "uid": "loki"
     }
    }
   ]
  }
 ]
}
