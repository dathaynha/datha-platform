{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // topology.ts / max-deliver.ts are entries, not just imports of reconcile.ts:
  // this repo owns the JetStream topology and their exported stream, consumer and
  // subject names are the source of truth every service mirrors in its own
  // src/nats/streams.ts. Unused *here* is the normal state for them.
  "entry": ["topology.ts", "max-deliver.ts"],
  // Exported but referenced only inside its own file is NOT dead: model files
  // legitimately export the constituent types of an exported interface or union
  // (deleting them would break the union; un-exporting them hurts consumers).
  "ignoreExportsUsedInFile": true,
  "project": ["*.ts"],
}
