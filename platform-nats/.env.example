NATS_URL=nats://localhost:4222

# Default max_deliver for platform durables without their own line below
NATS_CONSUMER_MAX_DELIVER=3

# Sync with file-service/.env — broker + file-service app DLQ use this for durable file-service-conversation-cleanup
NATS_CONSUMER_MAX_DELIVER_FILE_SERVICE_CONVERSATION_CLEANUP=3

# Sync with event-store/.env — ingest persistence failures before DLQ
NATS_CONSUMER_MAX_DELIVER_EVENT_STORE_INGEST=3

# Optional overrides for other durables:
# NATS_CONSUMER_MAX_DELIVER_EVENT_STORE_DLQ_INGEST=5
# Sync with notification-service/.env — projection failures before app DLQ publish
# NATS_CONSUMER_MAX_DELIVER_NOTIFICATION_SERVICE_EVENTS=3
# NATS_CONSUMER_MAX_DELIVER_NOTIFICATION_SERVICE_DLQ=3
# Sync with messenger-service/.env — call-history projection failures before terminal ack
# NATS_CONSUMER_MAX_DELIVER_MESSENGER_SERVICE_CALLS=3

# JetStream stream retention (nanoseconds applied at reconcile — align with event-store Postgres TTL policy)
# EVENTS stream: replay buffer if ingest is down (default 14d). Postgres query history: event-store EVENTS_RETENTION_DAYS (default 90d).
JETSTREAM_EVENTS_MAX_AGE_DAYS=14
# DLQ stream: ops buffer (default 30d). Postgres dlq_records: event-store DLQ_RETENTION_DAYS (default 180d).
JETSTREAM_DLQ_MAX_AGE_DAYS=30
