{
  "name": "event-store",
  "version": "1.0.0",
  "engines": {
    "node": ">=24 <25"
  },
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "scripts": {
    "knip": "knip",
    "dev": "tsx watch src/index.ts",
    "build": "tsc && rm -rf dist/db/migrations && mkdir -p dist/db && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "migrate": "node dist/db/migrate.js",
    "retain": "node dist/retain.js",
    "test": "vitest run",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test:cov": "vitest run --coverage",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\""
  },
  "dependencies": {
    "@fastify/sensible": "^6.0.3",
    "@nats-io/jetstream": "^3.3.0",
    "@nats-io/transport-node": "^3.3.0",
    "dotenv": "^16.5.0",
    "fastify": "^5.3.2",
    "fastify-plugin": "^5.0.1",
    "pg": "^8.13.3",
    "pino-opentelemetry-transport": "^4.0.2",
    "prom-client": "^15.1.3",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.11",
    "@vitest/coverage-v8": "^3.2.4",
    "knip": "^6.34.0",
    "prettier": "^3.8.1",
    "tsx": "^4.19.3",
    "typescript": "~5.9.3",
    "vitest": "^3.2.4"
  }
}
