# event-store — example environment (copy to .env locally; never commit .env)

# HTTP
PORT=3002

# NATS JetStream (local broker, e.g. nats://localhost:4222)
NATS_URL=nats://localhost:4222

# Postgres — create DB per your local Postgres setup (e.g. event_store_db)
DATABASE_URL=postgresql://postgres:password@localhost:5432/event_store_db

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sync with platform-nats/.env — ingest consumer app DLQ threshold
NATS_CONSUMER_MAX_DELIVER_EVENT_STORE_INGEST=3

# JetStream ingest pull batch size (optional)
# NATS_INGEST_BATCH_SIZE=25

# Postgres retention (pnpm retain — dry-run default; --execute to DELETE)
# Granularity is the MONTH: `events` is partitioned, and a partition is only
# dropped once its whole range is past the cutoff, so a row can outlive the TTL
# by up to a month.
EVENTS_RETENTION_DAYS=90
DLQ_RETENTION_DAYS=180

# Ceiling on the `total` the ops lists report (optional, default 10000).
# An exact COUNT(*) reads every matching row; the service counts a capped
# subquery instead and flags `totalCapped`, and the events list continues past
# the ceiling on a keyset cursor rather than a deep OFFSET.
# LIST_COUNT_CAP=10000
