{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // migrate.ts and retain.ts are their own CLI entries (pnpm migrate / retain).
  "entry": ["src/db/migrate.ts", "src/retain.ts", "src/**/*.test.ts"],
  // Exported but referenced only inside its own file is NOT dead: model files
  // legitimately export the constituent types of an exported interface or union
  // (deleting them would break the union; un-exporting them hurts consumers).
  "ignoreExportsUsedInFile": true,
  "project": ["src/**/*.ts"],
  // Named as a pino transport `target` string, which knip cannot resolve.
  "ignoreDependencies": ["pino-opentelemetry-transport"],
}
