# messenger-service — example environment (copy to .env locally; never commit .env)

# HTTP
PORT=3005

# Postgres — create the DB locally, e.g.
#   docker exec -it datha_platform_db createdb -U postgres messenger_service_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/messenger_service_db

# NATS — JetStream publish (the record) + core NATS fanout (the wire), plus the
# one durable this service consumes: `messenger-service-calls`, which projects
# call history from realtime-service's events.
# Topology is owned by platform-nats; this service never creates it.
NATS_URL=nats://localhost:4222

# Call-history projection: delivery attempts before the DLQ publish + ack.
# MUST match platform-nats reconcile for durable `messenger-service-calls`.
NATS_CONSUMER_MAX_DELIVER_MESSENGER_SERVICE_CALLS=3

# accounts-service workspace this service scopes conversations to. Phase 1 runs
# one shared workspace, matching accounts-service DEFAULT_WORKSPACE_SLUG.
DEFAULT_TENANT_ID=datha-platform

# Paging caps (also the cap on ?limit=)
CONVERSATIONS_PAGE_SIZE=30
MESSAGES_PAGE_SIZE=50
CALLS_PAGE_SIZE=50

# Group size guard
# A product cap, not a technical one — a mesh call is capped separately at 4
# (realtime-service MAX_CALL_PARTICIPANTS). Raising this needs no code change.
MAX_GROUP_PARTICIPANTS=10

# file-service, for attachment downloads. This service authorizes the reader by
# conversation membership, then asks file-service for a short-lived SAS URL as
# the uploader — file-service is owner-scoped and stays chat-blind.
FILE_SERVICE_URL=http://localhost:3001

# How long a call may stay unfinished before this service stops believing it.
# `ended_at` is written only by projecting a `call.ended` event, so a call whose
# event never arrives (NATS down, consumer stopped, message dead-lettered) would
# otherwise read as "in progress" forever. MUST be >= realtime-service's
# CALL_TTL_SECONDS (14400), which is the longest a call can legitimately live.
CALL_MAX_LIFETIME_SECONDS=21600
# How often those rows are closed for good. Readers apply the same bound
# immediately, so this only settles the stored data.
CALL_SWEEP_INTERVAL_SECONDS=900

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
