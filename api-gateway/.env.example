# api-gateway environment variables
# Copy to .env and fill in real values. Never commit .env.

# Listen port (default: 8080)
PORT=8080

# Google OAuth Web client credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-secret-from-console

# Azure Entra ID (SPA app registration). Use a multi-tenant app if you rely on organizations/consumers issuers.
AZURE_CLIENT_ID=your-entra-client-id

# AZURE_ALLOWED_TENANT_IDS: comma-separated directory (tenant) GUIDs allowed after Entra login (matches id_token "tid").
# If unset, AZURE_TENANT_ID is used as the only allowed tenant.
# Add Microsoft's consumer-directory GUID (documented by Microsoft as 9188040d-…) only if you enable the Personal Microsoft login path.
AZURE_ALLOWED_TENANT_IDS=your-first-allowed-tenant-guid,your-second-allowed-tenant-guid

# Home tenant / fallback allowlist seed when AZURE_ALLOWED_TENANT_IDS is omitted.
AZURE_TENANT_ID=your-entra-home-tenant-id

# Secret for signing/verifying internal JWTs and stream_tokens (api-gateway only — downstream services use X-Owner-ID).
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-a-strong-random-secret

# Internal JWT lifetime in seconds (default: 3600 = 1 hour)
JWT_TTL_SECONDS=3600

# Upstream service base URLs (no trailing slash)
CHATBOT_SERVICE_URL=http://localhost:8050
FILE_SERVICE_URL=http://localhost:3001
EVENT_STORE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3003

# accounts-service — platform users, workspaces, directory (/api/accounts/* → /users/*)
ACCOUNTS_SERVICE_URL=http://localhost:3006

# Messenger (phase 1). Both default to these values when unset, so an existing
# .env keeps booting — set them explicitly anywhere that is not localhost.
MESSENGER_SERVICE_URL=http://localhost:3005
REALTIME_SERVICE_URL=http://localhost:3004

# TTL of the token that authorises the realtime WebSocket. Short on purpose:
# it travels in a query string, which lands in access logs and proxy telemetry,
# and it is only needed at the moment of connect.
REALTIME_STREAM_TTL_SECONDS=90

# Optional — publish gateway.auth.login to JetStream (event-store ingest). Omit to disable.
NATS_URL=nats://localhost:4222

# Comma-separated allowed CORS origins
# 4000 = shell-frontend (host app), 4001 = chatbot-frontend (standalone dev)
# Also guards the WebSocket upgrade, which gets no CORS preflight — add the
# origin of any frontend that opens the realtime socket directly (4003 standalone).
CORS_ORIGINS=http://localhost:4000,http://localhost:4001,http://localhost:4002,http://localhost:4003

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
