# file-service environment variables
# Copy to .env and fill in values. Never commit .env.

# Listen port
PORT=3001

# PostgreSQL — separate database from chatbot-service
# Create it with: docker exec -it datha_platform_db createdb -U postgres file_service_db
# Then run: pnpm migrate
DATABASE_URL=postgresql://postgres:password@localhost:5432/file_service_db

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT=your-storage-account-name
AZURE_STORAGE_CONTAINER=your-container-name
# Standard connection string from Azure Portal > Storage account > Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# SAS URL lifetimes in seconds
SAS_UPLOAD_TTL_SECONDS=300
# Read SAS (open/preview); default 900 = 15 min — shorten via env if you want tighter leakage window
SAS_DOWNLOAD_TTL_SECONDS=900

# Max chat attachment upload size in bytes (default 20 MiB; align with chatbot-service worker).
MAX_UPLOAD_BYTES=20971520

# NATS JetStream (local broker, e.g. nats://localhost:4222)
NATS_URL=nats://localhost:4222
# Sync with platform-nats/.env — same name, same value (conversation.deleted consumer + app DLQ)
NATS_CONSUMER_MAX_DELIVER_FILE_SERVICE_CONVERSATION_CLEANUP=3

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
