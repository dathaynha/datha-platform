{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // migrate.ts is its own CLI entry (pnpm migrate). streams.ts is an entry because
  // its exports are the cross-repo sync surface for durable/subject names
  // (platform-nats owns the topology) — consumed by review, not by imports.
  "entry": ["src/db/migrate.ts", "src/nats/streams.ts", "src/**/*.test.ts"],
  // Exported but referenced only inside its own file is NOT dead: model files
  // legitimately export the constituent types of an exported interface or union
  // (deleting them would break the union; un-exporting them hurts consumers).
  "ignoreExportsUsedInFile": true,
  "project": ["src/**/*.ts"],
  // Named as a pino transport `target` string, which knip cannot resolve.
  "ignoreDependencies": ["pino-opentelemetry-transport"],
}
