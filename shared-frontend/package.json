{
  "name": "shared-frontend",
  "version": "0.6.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "knip": "knip",
    "ng": "ng",
    "build": "ng build platform-ui",
    "watch": "ng build platform-ui --watch --configuration development",
    "test": "ng test platform-ui --no-watch --browsers=ChromeHeadless --no-progress",
    "test:watch": "ng test platform-ui",
    "pack:check": "pnpm build && npm pack ./dist/platform-ui --dry-run",
    "version:check": "node ./scripts/verify-package-version.mjs",
    "format": "prettier --write \"**/*.{ts,json}\"",
    "format:check": "prettier --check \"**/*.{ts,json}\""
  },
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild",
      "lmdb",
      "msgpackr-extract"
    ]
  },
  "dependencies": {
    "@angular/common": "21.2.12",
    "@angular/compiler": "21.2.12",
    "@angular/core": "21.2.12",
    "@angular/forms": "21.2.12",
    "@angular/platform-browser": "21.2.12",
    "@angular/router": "21.2.12",
    "@primeuix/themes": "1.2.5",
    "primeng": "21.1.6",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.10",
    "@angular/build": "21.2.10",
    "@angular/cli": "21.2.10",
    "@angular/compiler-cli": "21.2.12",
    "@ngx-translate/core": "17.0.0",
    "@types/jasmine": "~6.0.0",
    "jasmine-core": "~6.0.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.2.0",
    "karma-junit-reporter": "2.0.1",
    "knip": "^6.34.0",
    "ng-packagr": "21.2.0",
    "prettier": "^3.8.1",
    "typescript": "5.9.3"
  }
}
