{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // public-api.ts is the published entry of @datha/platform-ui — everything it
  // re-exports is consumed by the three frontends, not from inside this repo.
  "entry": [
    "projects/platform-ui/src/public-api.ts",
    "projects/platform-ui/src/**/*.spec.ts",
  ],
  // Exported but referenced only inside its own file is NOT dead: model files
  // legitimately export the constituent types of an exported interface or union
  // (deleting them would break the union; un-exporting them hurts consumers).
  "ignoreExportsUsedInFile": true,
  "project": ["projects/platform-ui/src/**/*.ts"],
}
