# realtime-service — example environment (copy to .env locally; never commit .env)

# HTTP
PORT=3004

# Redis — presence keys (per connection) and live call state, both TTL-expired
REDIS_URL=redis://localhost:6379

# NATS — core subjects for live frames (rt.owner.*, rt.presence.*, rt.conv.*)
# plus JetStream publish of events.messenger.call.{started,ended,missed}.
# Topology is owned by platform-nats; this service never creates streams.
NATS_URL=nats://localhost:4222

# messenger-service, for the things this service cannot answer itself: may this
# owner open this conversation, and who else is in it (the callee of a call is
# resolved from membership here, never from the client's frame).
MESSENGER_SERVICE_URL=http://localhost:3005

# Socket behaviour
WS_PING_INTERVAL_SECONDS=25
WS_MAX_CONNECTIONS_PER_OWNER=5
PRESENCE_TTL_SECONDS=45
PRESENCE_HEARTBEAT_SECONDS=15
TYPING_TTL_SECONDS=8

# --- WebRTC ------------------------------------------------------------------
# coturn runs in `use-auth-secret` mode from _local/docker-compose.yml, and is
# opt-in there: `docker compose up -d coturn`.
#
# The secret below is NOT a secret locally: it is the literal fallback baked
# into that compose file, so copying this file gives a working relay with no
# extra steps. It must be identical on both sides — coturn holds the key, this
# service signs `<expiry>:<owner_id>` with it, and the browser only ever
# receives the signature. A long-lived TURN credential in a SPA bundle would be
# a relay-bandwidth theft vector, which is why nothing here reaches the client.
#
# EVERY DEPLOYED ENVIRONMENT GENERATES ITS OWN (`openssl rand -base64 32`) and
# keeps it in Key Vault / an ADO variable group. Never reuse this value outside
# localhost: anyone holding it can mint credentials and relay traffic on your
# bandwidth.
#
# A mismatch between the two sides is SILENT — calls still connect whenever the
# peers can reach each other directly, which on one machine is always, and fail
# only for someone behind symmetric NAT. Check what coturn actually holds with:
#   docker inspect datha_platform_coturn --format '{{json .Args}}'
TURN_STATIC_SECRET=datha-local-turn-secret

# --- Hosted TURN (alternative to the shared secret above) --------------------
# A provider that does not speak coturn's REST/HMAC scheme hands out a fixed
# username and password instead. Set both and they are served verbatim in place
# of a signed credential; TURN_STATIC_SECRET is then ignored, and the service
# says so at startup.
#
# Weaker on purpose, and only for a relay that expects it: a long-lived
# credential reaching the browser is the bandwidth-theft vector the HMAC scheme
# prevents. NEVER point our own coturn at these.
#
# Why it exists: this platform is developed behind CGNAT (the router's WAN is a
# private 10.x address, 2026-09-13), so a self-hosted coturn has no address the
# far peer can reach and no port forward can create one. A hosted relay is the
# only way to exercise the relay path from here — do not delete this block as
# clutter and rediscover that the hard way. Which relays answer this ISP, and
# how it was measured: `.claude/docs/platform/platform-backlog.md`.
#
#   TURN_USERNAME=<from the metered.ca dashboard>
#   TURN_PASSWORD=<from the metered.ca dashboard>
# ...and switch TURN_URLS below to match.
TURN_USERNAME=
TURN_PASSWORD=

# Where the browser dials coturn. 127.0.0.1 rather than localhost on purpose:
# the container advertises 127.0.0.1 as its relay address (--external-ip), and
# `localhost` can resolve to ::1, which would not match. UDP is preferred; the
# TCP entry is the fallback for networks that block UDP outright.
#
# Switching between local coturn and a hosted relay is a comment toggle: swap
# which of these two lines is live, and set (or clear) the credentials above.
# They must move together — hosted URLs with the local secret authenticate
# against nothing, and the failure is a silent ICE timeout, not an error.
TURN_URLS=turn:127.0.0.1:3478?transport=udp,turn:127.0.0.1:3478?transport=tcp
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443?transport=tcp

# STUN needs no credentials, so a public server is fine.
STUN_URLS=stun:stun.l.google.com:19302
TURN_CREDENTIAL_TTL_SECONDS=300

# Clearing both TURN vars is a supported state, not a broken one:
# /turn-credentials then serves STUN only and says so with `relay: false` —
# enough for two tabs on one machine, and it fails behind symmetric NAT.
# Half-configured (a secret with no URLs, or the reverse) is treated as empty
# and warned about at startup.

# How long an unanswered invite rings before the server publishes call.missed.
CALL_RING_TIMEOUT_SECONDS=30
# Ceiling on live call state in Redis. This is cleanup after a crashed instance,
# not a call-duration limit — a call ending normally deletes its own state.
CALL_TTL_SECONDS=14400

# Who this process is, so calls stranded by a crash can be told from calls
# somebody is still sitting in. Defaults to the hostname (the pod name under
# Kubernetes), which is what you want: it changes when the process is replaced.
# INSTANCE_ID=realtime-1
# How often the liveness key is re-armed, and how long it survives without a
# beat. The TTL is several beats on purpose: a missed beat under load must not
# declare a healthy instance dead and tear down live calls.
INSTANCE_HEARTBEAT_SECONDS=10
INSTANCE_TTL_SECONDS=45
# How often calls whose instance is gone are ended properly. Without this a
# crashed instance's calls expire in silence, no `call.ended` is ever published,
# and messenger-service's projection says the call is running forever.
CALL_REAP_INTERVAL_SECONDS=60

# How many people one call may hold, including the caller. This is a mesh limit,
# not a policy one: every peer holds N-1 connections and uplinks its own video
# N-1 times, so it stops being usable at about four. A group *conversation* holds
# far more (MAX_GROUP_PARTICIPANTS=50 in messenger-service) — calling in one
# larger than this is refused at invite time with `not_supported`.
MAX_CALL_PARTICIPANTS=4

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
