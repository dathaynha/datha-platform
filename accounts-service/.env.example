# accounts-service — example environment (copy to .env locally; never commit .env)

# HTTP
PORT=3006

# Postgres — create the DB locally, e.g.
#   docker exec -it datha_platform_db createdb -U postgres accounts_service_db
DATABASE_URL=postgresql://postgres:password@localhost:5432/accounts_service_db

# Phase 0 directory model: one shared workspace every signed-in user joins,
# so people can find each other. The schema is multi-tenant either way.
DEFAULT_WORKSPACE_SLUG=datha-platform
DEFAULT_WORKSPACE_NAME=DatHa Platform

# Max rows returned by directory search (also the cap on ?limit=)
DIRECTORY_MAX_RESULTS=25

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
