{
  "permissions": {
    "allow": [
      "Bash(az account *)",
      "Bash(az group *)",
      "Bash(az keyvault *)",
      "Bash(git checkout *)",
      "Bash(git pull *)",
      "Bash(git tag *)",
      "Bash(git push *)"
    ],
    "deny": [
      "Read(**/.env)",
      "Edit(**/.env)",
      "Write(**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/prettier-check.sh"
          }
        ]
      }
    ]
  }
}
