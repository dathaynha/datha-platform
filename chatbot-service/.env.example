# PostgreSQL — from repo root: docker compose up -d postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=chatbot_service
DB_USER=postgres
DB_PASSWORD=password
# SQLAlchemy rewrites this URL for async API (+asyncpg) and the worker (+psycopg).
DATABASE_URL=postgresql://postgres:password@localhost:5432/chatbot_service

# Redis — from repo root: docker compose up -d redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Google AI Studio / Gemini (Generative Language API) — never commit real keys
GEMINI_API_KEY=
# Sidebar titles after the first reply (generateContent). Lite keeps flash RPD for chat.
GEMINI_TITLE_MODEL=gemini-3.5-flash-lite

# Chat model picker: default when the UI has no saved choice (POST /messages fallback).
CHAT_DEFAULT_MODEL=gemini-3.6-flash
# Optional comma-separated ids for GET /models + POST /messages. Leave empty to use Google models.list (filtered).
# A non-empty allowlist MUST include CHAT_DEFAULT_MODEL, or POST /messages rejects the default.
CHAT_MODEL_ALLOWLIST=

# Internal URL for file-service (worker uses this to fetch SAS download URLs for attachments).
FILE_SERVICE_URL=http://localhost:3001

# NATS JetStream — local NATS with JetStream enabled
NATS_URL=nats://localhost:4222

# Postgres outbox drain (API lifespan): retry publishes when NATS was down at write time
EVENT_OUTBOX_POLL_SECONDS=5
EVENT_OUTBOX_BATCH_SIZE=25
EVENT_OUTBOX_MAX_BACKOFF_SECONDS=3600

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Worker retry against Gemini (in-process attempts, not NATS redeliveries).
# Only applies before the first streamed chunk; 1 disables retry.
GENERATION_RETRY_ATTEMPTS=3
GENERATION_RETRY_BASE_DELAY_SECONDS=1.0
GENERATION_RETRY_MAX_DELAY_SECONDS=8.0

# Worker metrics port (prometheus scrape; default 8051)
CHATBOT_WORKER_METRICS_PORT=8051
