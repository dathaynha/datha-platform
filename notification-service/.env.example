# notification-service — example environment (copy to .env locally; never commit .env)

# HTTP
PORT=3003

# NATS JetStream (local broker, e.g. nats://localhost:4222)
NATS_URL=nats://localhost:4222

# Postgres — create DB per your local Postgres setup (e.g. notification_service_db)
DATABASE_URL=postgresql://postgres:password@localhost:5432/notification_service_db

# Optional — push logs (OTLP) to the observability stack (platform-observability repo, Alloy :4318).
# Omit to log to stdout only. Metrics are always exposed on /metrics regardless.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Sync with platform-nats/.env — events projection app DLQ threshold
NATS_CONSUMER_MAX_DELIVER_NOTIFICATION_SERVICE_EVENTS=3

# JetStream pull batch size (optional)
# NATS_INGEST_BATCH_SIZE=25

# Read notifications older than this are purged by the in-app sweep
NOTIFICATIONS_READ_RETENTION_DAYS=30

# Web Push (phase 3 wave 1) — VAPID keypair; push sending disabled when unset.
# Generate once: npx web-push generate-vapid-keys
# Public key is also pinned in shell-frontend environment.ts (they must match).
VAPID_PUBLIC_KEY=BGiG7FzvfqNVOO5aF_5D5oCzqGVSPPhyBstq7CpRhv-qMmT3gvX6BWMmFyiBtMrY9BkqAVgedDErkip8Jhianqc
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:dathaynha@gmail.com

# Email digest (phase 3 wave 2) — SMTP transport; digest disabled (warn) when SMTP_HOST unset.
# Local default = Mailpit from _local infra (catches all mail, web inbox http://localhost:8025).
# Real-delivery test: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_SECURE=true + app-password creds.
# Prod: managed provider (needs domain + SPF/DKIM) — swap env only, never self-host delivery.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DatHa Platform <noreply@datha.local>"

# Hours between digest emails per owner (daily)
NOTIFICATIONS_DIGEST_MIN_INTERVAL_HOURS=24

# Shell base URL — digest links + send-time i18n catalog (/assets/i18n/<locale>.json)
SHELL_PUBLIC_URL=http://localhost:4000
